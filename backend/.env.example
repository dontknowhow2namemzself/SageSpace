OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Google Books (book recommendations metadata, optional) ─────────────────
# Validates recommended books + fetches blurbs (core/books_api.py). WITHOUT a
# key the call still works but uses the shared anonymous quota, which 429s
# almost immediately (recs then show, degraded, without blurbs). A free key
# lifts the quota to ~1000/day (no billing): in Google Cloud Console, create a
# project, enable "Books API", then Credentials -> Create API key.
GOOGLE_BOOKS_API_KEY=AIza-your-google-books-key-here

# ── LangSmith tracing (optional) ──────────────────────────────────────────
# Traces every chat-turn graph run: intent, retrieve (tool calls), synthesize,
# finalize. Leave LANGCHAIN_TRACING_V2 unset/false to disable entirely (no
# network calls). When enabled, set a key from https://smith.langchain.com.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
LANGCHAIN_PROJECT=sagespace
# Endpoint defaults to the US instance (api.smith.langchain.com). If your
# LangSmith account is EU-region, you MUST set this or trace ingestion is
# rejected with HTTP 403 Forbidden:
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# ── Deployment (all optional; defaults preserve local-dev behavior) ────────
# Root directory for persistent application state: sagespace.db,
# sagespace_checkpoints.db, chroma_db/, uploads/, exports/.
# Unset = the backend source directory.
# Production mounts a volume and sets e.g. SAGESPACE_DATA_DIR=/data.
# SAGESPACE_DATA_DIR=/data

# Comma-separated exact CORS allowlist (no paths or wildcard). Unset =
# localhost dev origins. Irrelevant when the frontend is served same-origin
# behind the nginx proxy.
# CORS_ORIGINS=https://your-domain.example

# Per-IP rate limits. Off by default so dev and tests are unaffected; set 1
# in production. Values use SlowAPI syntax and fail fast when malformed.
# RATE_LIMIT_ENABLED=1
# CHAT_RATE_LIMIT=20/minute
# INGEST_RATE_LIMIT=10/hour

# Public URL of the deployed app; sent as HTTP-Referer on OpenRouter cover
# generation calls (OpenRouter uses it for app attribution/rankings).
# PUBLIC_APP_URL=https://your-domain.example
